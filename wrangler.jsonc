{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-recruiting-agent",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RecruitingAgent",
        "class_name": "RecruitingAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RecruitingAgent"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
